# cOCR Workbench environment configuration
# Copy this file to `.env`:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / macOS)

# Host and port of the GUI web server
# Use 127.0.0.1 for local access or 0.0.0.0 for containers/network access
COCR_HOST=127.0.0.1
COCR_PORT=8765

# Comma-separated list of web origins allowed to access the API
COCR_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Server sandbox mode (1, true, or yes to enable; 0, false, or no to disable)
# When enabled: the local folder dialog is disabled and files are processed in temp_uploads/<session_id>
COCR_CLOUD_MODE=0

# API key authentication (optional)
# If set, requests must include the X-API-Key header or Authorization: Bearer <key>
COCR_API_KEY=
